{
  "name": "sentinelgraph-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "server",
    "services",
    "sdk"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "next build",
    "build:backend": "npm run build -w server && npm run build -w services && npm run build -w sdk",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:backend"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.4",
    "dagre": "^0.8.5",
    "lucide-react": "^0.468.0",
    "next": "^14.2.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.52",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.0"
  }
}
